<div class="hero" style="background-image: url('<%= @list.image_url %>')">
  <div class="hero-content">
    <h1><%= @list.name %></h1>
  </div>
  <span class="movies-count"><%= @list.bookmarks.count %> movies</span>
</div>

<div class="container">
  <div class="lists-header">
    <div></div>
    <%= link_to "add a movie", new_list_bookmark_path(@list), class: "btn-green" %>
  </div>

  <div class="movies-grid">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="movie-card">
        <img src="<%= bookmark.movie.poster_url %>" alt="<%= bookmark.movie.title %>">
        <div class="movie-card-body">
          <p><strong><%= bookmark.movie.title %></strong> • <%= bookmark.movie.rating %> ⭐</p>
          <p class="movie-overview"><%= bookmark.movie.overview %></p>
          <%= link_to "delete", bookmark_path(bookmark), data: { turbo_method: :delete }, class: "delete-link" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
