<div class="hero">
  <div class="hero-content">
    <h1>Save any kind of movies</h1>
    <p>Classic</p>
  </div>
</div>

<div class="container">
  <div class="lists-header">
    <h2>My Lists</h2>
    <%= link_to "Create a movie list", new_list_path, class: "btn-green" %>
  </div>

  <div class="lists-grid">
    <% @lists.each do |list| %>
      <%= link_to list_path(list) do %>
        <div class="list-card" style="background-image: url('<%= list.image_url %>')">
          <div class="list-card-overlay">
            <h3><%= list.name %></h3>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
